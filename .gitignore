# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv/
env/
venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Operating System & IDE
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/

# DuckDB database and WAL files
*.duckdb
*.duckdb.*
*.duckdb.bak
*.duckdb.tmp
*.duckdb.wal
*.duckdb.wal.bak

# Large archive files
*.tar
*.tar.gz
*.tgz
*.zip

# Support bundle drop folder (keep directory structure)
/bundles/*
!/bundles/.gitkeep

# Host snapshot folder (keep directory structure)
/host-snapshot/*
!/host-snapshot/.gitkeep

# Data directory: sessions, uploads, and temporary files
/data/*
!/data/.gitkeep
!/data/sessions/
/data/sessions/*
!/data/sessions/.gitkeep
!/data/uploads/
/data/uploads/*
!/data/uploads/.gitkeep
